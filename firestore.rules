rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'superAdmin');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superAdmin';
    }

    function isDeveloper() {
      return isAuthenticated() && getUserData().role == 'developer';
    }

    function isEmployee() {
      return isAuthenticated() && getUserData().role == 'employee';
    }

    function isDeveloperPanel() {
      return isDeveloper() || isEmployee();
    }

    function ownsAssignedOffer() {
      return isAuthenticated()
        && resource.data.assignedDeveloperUid is string
        && (
          resource.data.assignedDeveloperUid == request.auth.uid
          || (isEmployee() && getUserData().developerUid == resource.data.assignedDeveloperUid)
        );
    }

    function isViewIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is number
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    match /users/{userId} {
      function isSelf() {
        return isAuthenticated() && request.auth.uid == userId;
      }

      function identityUnchanged() {
        return request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('uid', userId) == resource.data.get('uid', userId)
          && request.resource.data.get('email', '') == resource.data.get('email', '')
          && request.resource.data.get('developerUid', '') == resource.data.get('developerUid', '')
          && request.resource.data.get('status', '') == resource.data.get('status', '');
      }

      function permissionsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions']);
      }

      function isSafeSelfUpdate() {
        return isSelf()
          && identityUnchanged()
          && permissionsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastName', 'phoneNumber', 'companyName', 'photoURL', 'lastLoginAt', 'lastLoginIp']);
      }

      function isAdminUpdatingOtherUser() {
        return isAdmin()
          && !isSelf()
          && identityUnchanged()
          && (isSuperAdmin() || permissionsUnchanged());
      }

      function isDeveloperUpdatingEmployeeStatus() {
        return isDeveloper()
          && resource.data.role == 'employee'
          && resource.data.developerUid == request.auth.uid
          && request.resource.data.role == 'employee'
          && request.resource.data.developerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      function isEmployeeSelfCreate() {
        return isSelf()
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.role == 'employee'
          && request.resource.data.developerUid is string
          && request.resource.data.developerUid.size() > 0
          && exists(/databases/$(database)/documents/users/$(request.resource.data.developerUid))
          && get(/databases/$(database)/documents/users/$(request.resource.data.developerUid)).data.role == 'developer';
      }

      allow read: if isAdmin()
        || isSelf()
        || (isDeveloper() && resource.data.developerUid == request.auth.uid);
      allow create: if isEmployeeSelfCreate();
      allow update: if !(isSelf() && !permissionsUnchanged())
        && (isSafeSelfUpdate()
          || isAdminUpdatingOtherUser()
          || isDeveloperUpdatingEmployeeStatus());
      allow delete: if (isAdmin() && !isSelf())
        || (isDeveloper() && resource.data.role == 'employee' && resource.data.developerUid == request.auth.uid);
      
      match /auditLogs/{logId} {
        allow read: if isAdmin()
          || (isAuthenticated() && request.auth.uid == userId)
          || (isDeveloper() && get(/databases/$(database)/documents/users/$(userId)).data.developerUid == request.auth.uid);
        allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      }
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /properties/{propertyId} {
      allow read: if true; 
      allow write: if isAdmin() || isDeveloperPanel();
      allow update: if isViewIncrement();
    }
    
    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin() || isDeveloperPanel();
      allow update: if isViewIncrement();
    }

    match /herosection/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /company/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /maintenance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuOptions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /sell_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /sales_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /interest_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow create, delete: if isAdmin();
      allow list: if isAdmin()
        || (isAuthenticated() && resource.data.developerUid == request.auth.uid)
        || ownsAssignedOffer();
      allow get: if true;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.developerUid == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt', 'respondedAt']);
    }

    match /contracts/{contractId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.developerUid == request.auth.uid);
      allow write: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}